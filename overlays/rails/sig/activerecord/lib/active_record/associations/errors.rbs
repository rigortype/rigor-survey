    def initialize: (?untyped) -> void
  end
  class AmbiguousSourceReflectionForThroughAssociation < ::ActiveRecord::ActiveRecordError
    def initialize: (untyped, untyped, untyped, untyped, untyped) -> void
  end
  class ThroughNestedAssociationsAreReadonly < ::ActiveRecord::ActiveRecordError
    def initialize: (?untyped, ?untyped) -> void
  end
  class EagerLoadPolymorphicError < ::ActiveRecord::ActiveRecordError
    def initialize: (?untyped) -> void
  end
  class DeleteRestrictionError < ::ActiveRecord::ActiveRecordError
    def initialize: (?untyped) -> void
  end
