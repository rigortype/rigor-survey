module Dependabot
  module Composer
    class UpdateChecker < ::Dependabot::UpdateCheckers::Base
      def latest_version: () -> (Dependabot::Version | String | nil)
      def latest_resolvable_version: () -> (Dependabot::Version | nil)
      def lowest_resolvable_security_fix_version: () -> (Dependabot::Version | nil)
      def latest_resolvable_version_with_no_unlock: () -> (Dependabot::Version | nil)
      def updated_requirements: () -> Array[Dependabot::DependencyRequirement | ::DependencyRequirement]
      def requirements_unlocked_or_can_be?: () -> (false | true)
    end
  end
end
