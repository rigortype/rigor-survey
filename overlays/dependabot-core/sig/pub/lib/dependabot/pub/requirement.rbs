module Dependabot
  module Pub
    class Requirement < ::Dependabot::Requirement
      def self.requirements_array: (untyped) -> [Dependabot::Pub::Requirement]
      def self.parse_dep_string: (untyped) -> (nil | { name: untyped, normalised_name: untyped, version: String | nil, requirement: untyped, extras: nil })
      def initialize: (*untyped, ?raw_constraint: untyped) -> void
    end
  end
end
