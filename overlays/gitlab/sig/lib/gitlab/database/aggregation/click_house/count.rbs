module Gitlab
  module Database
    module Aggregation
      module ClickHouse
        class Count < ::Gitlab::Database::Aggregation::ClickHouse::MetricDefinition
          def initialize: (?untyped, ?untyped, ?untyped, ?distinct: untyped, **untyped) -> void
