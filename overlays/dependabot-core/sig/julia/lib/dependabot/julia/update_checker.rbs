module Dependabot
  module Julia
    class UpdateChecker < ::Dependabot::UpdateCheckers::Base
      def initialize: (dependency: untyped, dependency_files: untyped, credentials: untyped, ?repo_contents_path: untyped, ?ignored_versions: untyped, ?raise_on_ignored: untyped, ?security_advisories: untyped, ?requirements_update_strategy: untyped, ?dependency_group: untyped, ?update_cooldown: untyped, ?options: untyped) -> void
      def latest_version: () -> (Gem::Version | nil)
      def latest_resolvable_version: () -> (Gem::Version | nil)
      def lowest_security_fix_version: () -> (Gem::Version | nil)
      def lowest_resolvable_security_fix_version: () -> (Gem::Version | nil)
      def latest_resolvable_version_with_no_unlock: () -> (Dependabot::Julia::Version | nil)
      def updated_requirements: () -> Array[Dependabot::DependencyRequirement]
    end
  end
end
