module Gitlab
  module DataBuilder
    module Repository
      def update: (untyped, untyped, untyped, untyped) -> { event_name: "repository_update", user_id: untyped, user_name: untyped, user_email: untyped, user_avatar: untyped, project_id: untyped, project: untyped, changes: untyped, refs: untyped }
      def single_change: (untyped, untyped, untyped) -> { before: untyped, after: untyped, ref: untyped }
      def sample_data: () -> { event_name: "repository_update", user_id: 10, user_name: "john.doe", user_email: "test@example.com", user_avatar: "http://example.com/avatar/user.png", project_id: 40, changes: [{ before: "8205ea8d81ce0c6b90fbe8280d118cc9fdad6130", after: "4045ea7a3df38697b3730a20fb73c8bed8a3e69e", ref: "refs/heads/master" }], refs: ["refs/heads/master"] }
    end
  end
end
