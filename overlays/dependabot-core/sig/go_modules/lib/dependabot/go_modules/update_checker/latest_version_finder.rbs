module Dependabot
  module GoModules
    class UpdateChecker < ::Dependabot::UpdateCheckers::Base
      class LatestVersionFinder < ::Dependabot::Package::PackageLatestVersionFinder
        def initialize: (dependency: untyped, dependency_files: untyped, credentials: untyped, ignored_versions: untyped, security_advisories: untyped, ?raise_on_ignored: untyped, ?cooldown_options: untyped) -> void
        def latest_version: (?language_version: untyped) -> (Dependabot::Version | nil)
        def lowest_security_fix_version: (?language_version: untyped) -> (Dependabot::Version | nil)
        def cooldown_enabled?: () -> true
      end
    end
  end
end
