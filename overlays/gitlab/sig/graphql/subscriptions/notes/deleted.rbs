        def self.new: (?model_id: untyped, ?model_name: untyped, ?discussion_model_id: untyped, ?last_discussion_note: untyped, ?noteable: untyped) -> instance | (?untyped model_id, ?untyped model_name, ?untyped discussion_model_id, ?untyped last_discussion_note, ?untyped noteable) -> instance
