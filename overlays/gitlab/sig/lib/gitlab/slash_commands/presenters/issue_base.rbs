module Gitlab
  module SlashCommands
    module Presenters
      module IssueBase
        def color: (untyped) -> ("#38ae67" | "#d22852")
        def status_text: (untyped) -> ("Closed" | "Open")
        def fields: () -> [{ title: "Assignee", value: untyped, short: true }, { title: "Milestone", value: untyped, short: true }, { title: "Labels", value: untyped, short: true }]
      end
    end
  end
end
