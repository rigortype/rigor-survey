module Dependabot
  module Terraform
    class UpdateChecker < ::Dependabot::UpdateCheckers::Base
      def latest_version: () -> (Dependabot::Terraform::Version | Dependabot::Version | String | nil)
      def latest_resolvable_version: () -> (Gem::Version | String | nil)
      def latest_resolvable_version_with_no_unlock: () -> nil
      def updated_requirements: () -> Array[Dependabot::DependencyRequirement]
      def requirements_unlocked_or_can_be?: () -> (false | true)
    end
  end
end
