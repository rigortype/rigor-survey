module Gitlab
  module Database
    module Migrations
      class Runner
        def self.up: (database: untyped) -> Gitlab::Database::Migrations::Runner
        def self.down: (database: untyped) -> Gitlab::Database::Migrations::Runner
        def self.migration_file_names_this_branch: () -> Array[String]
        def initialize: (direction: Symbol, database: untyped, migrations: []) -> void
        def direction: () -> :up
        def migrations: () -> []
      end
    end
  end
end
