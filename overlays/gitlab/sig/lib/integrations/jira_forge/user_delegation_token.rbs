module Integrations
  module JiraForge
    class UserDelegationToken
      def self.build: (user: untyped, account_id: untyped, cloud_id: untyped) -> Integrations::JiraForge::UserDelegationToken
      def self.decode: (untyped) -> (Integrations::JiraForge::UserDelegationToken | nil)
      def initialize: (user_id: untyped, account_id: nil, cloud_id: nil) -> void
