module Gitlab
  module Diff
    class ViewerHunk
      def self.init_from_diff_lines: (untyped) -> Array[untyped]
      def self.init_from_expanded_lines: (untyped, untyped, untyped) -> ([Gitlab::Diff::ViewerHunk, Gitlab::Diff::ViewerHunk] | [Gitlab::Diff::ViewerHunk] | [])
      def self.create_viewer_hunks: (untyped, untyped, untyped) -> ([Gitlab::Diff::ViewerHunk, Gitlab::Diff::ViewerHunk] | [Gitlab::Diff::ViewerHunk])
      def initialize: (?lines: untyped, ?header: untyped) -> void
      def parallel_lines: () -> (Array[untyped] | nil)
    end
    class ViewerHunkHeader
      def initialize: (untyped, Integer | nil, Integer | nil) -> void
      def expand_directions: () -> (Array[untyped] | [:both])
    end
  end
end
