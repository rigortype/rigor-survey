module Gitlab
  module GithubImport
    module Importer
      class SingleEndpointIssueEventsImporter
        def initialize: (untyped, untyped, ?parallel: untyped) -> void
        def importer_class: () -> singleton(Gitlab::GithubImport::Importer::IssueEventImporter)
        def representation_class: () -> singleton(Gitlab::GithubImport::Representation::IssueEvent)
        def sidekiq_worker_class: () -> singleton(Gitlab::GithubImport::ImportIssueEventWorker)
        def object_type: () -> :issue_event
        def collection_method: () -> :issue_timeline
        def parent_imported_cache_key: () -> String
        def page_keyset_id: (untyped) -> String
        def collection_options: () -> {}
        def compose_associated_id!: (untyped, untyped) -> (String | nil)
        def import_settings: () -> Gitlab::GithubImport::Settings
        def events_cache: () -> Gitlab::GithubImport::EventsCache
      end
    end
  end
end
