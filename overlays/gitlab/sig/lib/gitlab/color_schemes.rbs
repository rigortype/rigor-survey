module Gitlab
  module ColorSchemes
    def self.available_schemes: () -> [Gitlab::ColorSchemes::Scheme, Gitlab::ColorSchemes::Scheme, Gitlab::ColorSchemes::Scheme, Gitlab::ColorSchemes::Scheme, Gitlab::ColorSchemes::Scheme, Gitlab::ColorSchemes::Scheme, Gitlab::ColorSchemes::Scheme]
    def self.body_classes: () -> String
    def self.count: () -> 7
    def self.each: () ?{ (*untyped) -> untyped } -> Array[Gitlab::ColorSchemes::Scheme]
    def self.valid_ids: () -> [untyped, untyped, untyped, untyped, untyped, untyped, untyped]
    class Scheme < ::Struct[untyped]
      def id: () -> untyped
      def name: () -> untyped
      def css_class: () -> untyped
      def id=: (untyped) -> untyped
      def name=: (untyped) -> untyped
      def css_class=: (untyped) -> untyped
      def self.new: (?id: untyped, ?name: untyped, ?css_class: untyped) -> instance | (?untyped id, ?untyped name, ?untyped css_class) -> instance
      def self.[]: (?id: untyped, ?name: untyped, ?css_class: untyped) -> instance | (?untyped id, ?untyped name, ?untyped css_class) -> instance
    end
  end
end
