module Gitlab
  module Ci
    module Parsers
      def self.parsers: () -> { junit: singleton(Gitlab::Ci::Parsers::Test::Junit), cobertura: singleton(Gitlab::Ci::Parsers::Coverage::Cobertura), terraform: singleton(Gitlab::Ci::Parsers::Terraform::Tfplan), accessibility: singleton(Gitlab::Ci::Parsers::Accessibility::Pa11y), jacoco: singleton(Gitlab::Ci::Parsers::Coverage::Jacoco), codequality: singleton(Gitlab::Ci::Parsers::Codequality::CodeClimate), sast: singleton(Gitlab::Ci::Parsers::Security::Sast), secret_detection: singleton(Gitlab::Ci::Parsers::Security::SecretDetection) }
      def self.fabricate!: (untyped, *untyped, **untyped) -> (Gitlab::Ci::Parsers::Accessibility::Pa11y | Gitlab::Ci::Parsers::Codequality::CodeClimate | Gitlab::Ci::Parsers::Coverage::Cobertura | Gitlab::Ci::Parsers::Coverage::Jacoco | Gitlab::Ci::Parsers::Security::Sast | Gitlab::Ci::Parsers::Security::SecretDetection | Gitlab::Ci::Parsers::Terraform::Tfplan | Gitlab::Ci::Parsers::Test::Junit)
      def self.instrument!: () -> Array[singleton(Gitlab::Ci::Parsers::Accessibility::Pa11y) | singleton(Gitlab::Ci::Parsers::Codequality::CodeClimate) | singleton(Gitlab::Ci::Parsers::Coverage::Cobertura) | singleton(Gitlab::Ci::Parsers::Coverage::Jacoco) | singleton(Gitlab::Ci::Parsers::Security::Sast) | singleton(Gitlab::Ci::Parsers::Security::SecretDetection) | singleton(Gitlab::Ci::Parsers::Terraform::Tfplan) | singleton(Gitlab::Ci::Parsers::Test::Junit)]
    end
  end
end
