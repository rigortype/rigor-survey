module Gitlab
  module I18n
    def selectable_locales: (?untyped) -> Hash["bg" | "cs_CZ" | "da_DK" | "de" | "en" | "eo" | "es" | "fil_PH" | "fr" | "ga_IE" | "gl_ES" | "id_ID" | "it" | "ja" | "ko" | "nb_NO" | "nl_NL" | "pl_PL" | "pt_BR" | "ro_RO" | "ru" | "si_LK" | "tr_TR" | "uk" | "zh_CN" | "zh_HK" | "zh_TW", "Bulgarian - български" | "Chinese, Simplified - 简体中文" | "Chinese, Traditional (Hong Kong) - 繁體中文 (香港)" | "Chinese, Traditional (Taiwan) - 繁體中文 (台灣)" | "Czech - čeština" | "Danish - dansk" | "Dutch - Nederlands" | "English" | "Esperanto - esperanto" | "Filipino" | "French - français" | "Galician - galego" | "German - Deutsch" | "Indonesian - Bahasa Indonesia" | "Irish - Gaeilge" | "Italian - italiano" | "Japanese - 日本語" | "Korean - 한국어" | "Norwegian (Bokmål) - norsk (bokmål)" | "Polish - polski" | "Portuguese (Brazil) - português (Brasil)" | "Romanian - română" | "Russian - русский" | "Sinhalese - සිංහල" | "Spanish - español" | "Turkish - Türkçe" | "Ukrainian - українська"]
    def percentage_translated_for: (untyped) -> (0 | 1 | 100 | 11 | 12 | 22 | 29 | 3 | 4 | 45 | 5 | 51 | 72 | 95 | 96 | 98 | 99)
    def trimmed_language_name: (untyped) -> (String | nil)
    def available_locales: () -> ["bg", "cs_CZ", "da_DK", "de", "en", "eo", "es", "fil_PH", "fr", "gl_ES", "ga_IE", "id_ID", "it", "ja", "ko", "nb_NO", "nl_NL", "pl_PL", "pt_BR", "ro_RO", "ru", "si_LK", "tr_TR", "uk", "zh_CN", "zh_HK", "zh_TW"]
    def use_default_locale: () -> Symbol
    def setup: (domain: untyped, default_locale: untyped) -> ["bg", "cs_CZ", "da_DK", "de", "en", "eo", "es", "fil_PH", "fr", "gl_ES", "ga_IE", "id_ID", "it", "ja", "ko", "nb_NO", "nl_NL", "pl_PL", "pt_BR", "ro_RO", "ru", "si_LK", "tr_TR", "uk", "zh_CN", "zh_HK", "zh_TW"]
