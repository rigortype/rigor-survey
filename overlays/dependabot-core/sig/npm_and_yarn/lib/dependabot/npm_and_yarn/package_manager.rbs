module Dependabot
  module NpmAndYarn
    class PackageManagerDetector
      def initialize: (untyped, untyped) -> void
    end
    class PackageManagerHelper
      def initialize: (untyped, untyped, untyped, untyped) -> void
      def package_manager: () -> ::Ecosystem::VersionManager
      def language: () -> (Dependabot::NpmAndYarn::Language | ::Ecosystem::VersionManager)
      def language_requirement: () -> (::Requirement | nil)
