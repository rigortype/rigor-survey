module Admin
  module Metrics
    class Dimension
      class BaseDimension
        def self.with_params?: () -> false
        def initialize: (untyped, untyped, untyped, untyped) -> void
        def key: () -> bot
        def cache_key: () -> String
        def data: () -> (false | true)
        def self.model_name: () -> (String | nil)
        def loaded: () -> (false | true)
      end
    end
  end
end
