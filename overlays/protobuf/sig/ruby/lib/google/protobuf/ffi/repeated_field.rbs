module Google
  module Protobuf
    class RepeatedField
      def each: () ?{ (*untyped) -> untyped } -> Google::Protobuf::RepeatedField
      def []=: (untyped, untyped) -> nil
      def push: (*untyped) -> Google::Protobuf::RepeatedField
      def <<: (untyped) -> Google::Protobuf::RepeatedField
      def replace: (untyped) -> Google::Protobuf::RepeatedField
      def clear: () -> Google::Protobuf::RepeatedField
      def frozen?: () -> (false | true)
      def ==: (untyped) -> (false | true)
      def to_ary: () -> Array[untyped]
      def +: (untyped) -> Google::Protobuf::RepeatedField
      def concat: (untyped) -> Google::Protobuf::RepeatedField
    end
  end
end
