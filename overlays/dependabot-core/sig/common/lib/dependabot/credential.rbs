module Dependabot
  class Credential
    def initialize: (untyped) -> void
    def replaces_base?: () -> (false | true)
    def []: (untyped) -> (Value | nil)
    def merge: (untyped) -> Dependabot::Credential
    def to_h: () -> Hash[String, Value]
    def scope: () -> (Array[String] | nil)
  end
end
