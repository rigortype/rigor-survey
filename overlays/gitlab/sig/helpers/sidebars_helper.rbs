  def super_sidebar_logged_out_context: (panel: untyped, panel_type: untyped) -> Hash[untyped, untyped]
  def super_sidebar_logged_in_context: (untyped, group: untyped, project: untyped, panel: untyped, panel_type: untyped) -> Hash[untyped, untyped]
