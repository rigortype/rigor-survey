module Gitlab
  module Database
    module Aggregation
      module ClickHouse
        class BitmapWindow < ::Gitlab::Database::Aggregation::ClickHouse::MetricDefinition
          def initialize: (Symbol, ?Symbol, ?Proc | nil, operation: Symbol, over: Symbol, ?lag_offset: Integer, **untyped) -> void
          def validate_definition!: (untyped) -> nil
          def to_outer_arel: (untyped) -> Arel::Nodes::SqlLiteral
          def requires_window?: () -> true
          def build_window_sql: (untyped, untyped, ?over_alias: untyped, ?partition_aliases: untyped) -> (String | nil)
          def over_dimension: () -> (:event_date | :unknown_dimension)
          def operation: () -> (:difference | :intersection | :invalid_op | :lag | :reverse_difference)
          def lag_offset: () -> (2 | 3)
        end
      end
    end
  end
end
