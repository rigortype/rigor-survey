module ClickHouse
  module SchemaCache
    class Column
      def initialize: (name: String, type: String, **untyped) -> void
      def to_h: () -> Hash["comment" | "compression_codec" | "default_expression" | "default_kind" | "is_in_partition_key" | "is_in_primary_key" | "is_in_sampling_key" | "is_in_sorting_key" | "name" | "type", untyped]
      def name: () -> ("id" | "name" | "x")
      def type: () -> ("Nullable(UInt64)" | "String" | "UInt64")
    end
  end
end
