module Projects
  class OpenIssuesCountService < ::Projects::CountService
    def initialize: (untyped, ?untyped) -> void
    def cache_key_name: () -> ("public_open_issues_count" | "total_open_issues_count")
    def public_only?: () -> (false | true)
    def public_count_cache_key: () -> ["projects", "count_service", 1, untyped, "public_open_issues_count"]
    def total_count_cache_key: () -> ["projects", "count_service", 1, untyped, "total_open_issues_count"]
    def delete_cache: () -> Array[Array[untyped]]
  end
end
