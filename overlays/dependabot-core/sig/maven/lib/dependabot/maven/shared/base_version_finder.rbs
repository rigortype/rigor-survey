module Dependabot
  module Maven
    module Shared
      class BaseVersionFinder < ::Dependabot::Maven::Shared::SharedVersionFinder
        def latest_version_details: () -> (nil | { version: Dependabot::Version, source_url: String | nil })
        def lowest_security_fix_version_details: () -> (nil | { version: Dependabot::Version, source_url: String | nil })
      end
    end
  end
end
