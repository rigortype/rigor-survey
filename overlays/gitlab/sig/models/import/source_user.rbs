module Import
  class SourceUser < ::ApplicationRecord
    def self.find_source_user: (source_user_identifier: untyped, namespace: untyped, source_hostname: untyped, import_type: untyped) -> (Import::SourceUser | nil)
    def self.find_by_namespace_and_token: (namespace_id: untyped, reassignment_token: untyped) -> (Import::SourceUser | nil)
    def accepted_status?: () -> (false | true)
    def reassignable_status?: () -> (false | true)
    def cancelable_status?: () -> (false | true)
  end
end
