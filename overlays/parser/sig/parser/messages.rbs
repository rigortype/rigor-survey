module Parser
  module Messages
    def self.compile: (untyped, untyped) -> ("%{message}" | "%{name} is reserved for numbered parameter" | "%{type}: unknown type of percent-literal" | "&. inside multiple assignment destination" | "... after rest argument" | "... at EOL, should be parenthesized" | "BEGIN in method" | "Invalid return in class/module body" | "`%{name}' is not allowed as a class variable name" | "`%{name}' is not allowed as a global variable name" | "`%{name}' is not allowed as a local variable name" | "`%{name}' is not allowed as an instance variable name" | "`%{prefix}' interpreted as argument prefix" | "`it` calls without arguments refers to the first block param" | "ambiguity between regexp and two divisions: wrap regexp in parentheses or add a space after `/' operator" | "ambiguous first argument; put parentheses or a space even after the operator" | "anonymous block parameter is also used within block" | "anonymous keyword rest parameter is also used within block" | "anonymous rest parameter is also used within block" | "bare backslash only allowed before newline" | "block given to yield" | "both block argument and literal block are passed" | "cannot %{action}" | "cannot assign to a back-reference variable" | "cannot assign to a keyword" | "cannot assign to numbered parameter %{name}" | "cannot define a singleton method for a literal" | "cannot define an alias for a back-reference variable" | "circular argument reference %{var_name}" | "class definition in method body" | "class or module name must be a constant literal" | "clobbered by: %{action}" | "constant re-assignment" | "different replacements: %{replacement} vs %{other_replacement}" | "duplicate argument name" | "duplicate hash pattern key %{name}" | "duplicate variable name %{name}" | "dynamic constant assignment" | "else without rescue is useless" | "embedded document meets end of file (and they embark on a romantic journey)" | "empty symbol literal" | "escape sequence meets end of file" | "formal argument cannot be a class variable" | "formal argument cannot be a constant" | "formal argument cannot be a global variable" | "formal argument cannot be an instance variable" | "here document identifier across newlines, never match" | "here document identifier ends with a newline" | "identifier %{identifier} is not valid to get" | "incomplete character syntax" | "invalid Unicode codepoint (too large)" | "invalid Unicode escape" | "invalid character syntax; use ?%{escape}" | "invalid escape character syntax" | "invalid hex escape" | "invalid octal digit" | "is crossing that on:" | "is crossing:" | "key is duplicated and overwritten" | "literal contains escape sequences incompatible with UTF-8" | "module definition in method body" | "multiple assignment in conditional context" | "no .<digit> floating literal anymore; put 0 before dot" | "no anonymous block parameter" | "no anonymous keyword rest parameter" | "no anonymous rest parameter" | "no such local variable: `%{name}'" | "numbered parameter is already used in an outer scope" | "numeric literal without digits" | "odd number of entries for a hash" | "ordinary parameter is defined" | "setter method cannot be defined in an endless method definition" | "swallows some inner rewriting actions:" | "symbol literal with interpolation is not allowed" | "the deletion of:" | "the rewriting action on:" | "this replacement:" | "trailing `%{character}' in number" | "unexpected `%{character}'" | "unexpected token %{token}" | "unknown regexp options: %{options}" | "unterminated Unicode escape" | "unterminated heredoc id" | "unterminated string meets end of file" | String | nil)
  end
end
