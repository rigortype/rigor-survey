module Dependabot
  class PullRequestCreator
    class PrNamePrefixer
      def initialize: (source: untyped, dependencies: untyped, credentials: untyped, ?security_fix: untyped, ?commit_message_options: untyped) -> void
      def pr_name_prefix: () -> String
      def capitalize_first_word?: () -> (false | true)
      def commit_message_options: () -> (::CommitMessageOptions | nil)
    end
  end
end
