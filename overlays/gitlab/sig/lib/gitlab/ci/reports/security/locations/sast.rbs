module Gitlab
  module Ci
    module Reports
      module Security
        module Locations
          class Sast < ::Gitlab::Ci::Reports::Security::Locations::Base
            def initialize: (file_path: (String | nil), start_line: (Integer | nil), ?end_line: Integer, ?class_name: untyped, ?method_name: untyped) -> void
            def fingerprint_data: () -> String
            def end_line: () -> 1
            def file_path: () -> ("yarn.lock" | nil)
            def start_line: () -> (1 | nil)
          end
        end
      end
    end
  end
end
