module Gitlab
  module Repositories
    class DesignManagementRepository < ::Gitlab::Repositories::RepoType
      def name: () -> :design
      def suffix: () -> :design
      def access_checker_class: () -> singleton(Gitlab::GitAccessDesign)
      def guest_read_ability: () -> :download_code
      def container_class: () -> singleton(DesignManagement::Repository)
    end
  end
end
