module LooseForeignKeys
  class ModificationTracker
    def max_runtime: () -> ActiveSupport::Duration
    def max_deletes: () -> 100000
    def max_updates: () -> 50000
    def stats: () -> { over_limit: untyped, delete_count_by_table: Hash[untyped, untyped], update_count_by_table: Hash[untyped, untyped], delete_count: untyped, update_count: untyped }
  end
end
