module Gitlab
  module Ci
    class Config
      module Entry
        class Variable < ::Gitlab::Config::Entry::Simplifiable
          class SimpleVariable < ::Gitlab::Config::Entry::Node
            def self.applies_to?: (untyped) -> (false | true)
            def value_with_data: () -> { value: untyped }
            def value_with_prefill_data: () -> { value: untyped }
          end
          class ComplexVariable < ::Gitlab::Config::Entry::Node
            def self.applies_to?: (untyped) -> (false | true)
            def value_with_data: () -> Hash[untyped, untyped]
            def value_with_prefill_data: () -> Hash[untyped, untyped]
          end
          class UnknownStrategy < ::Gitlab::Config::Entry::Node
            def errors: () -> ["variable definition must be either a string or a hash"]
          end
        end
      end
    end
  end
end
