module Gitlab
  module Ci
    module Reports
      class TestReportSummary
        def initialize: ([untyped, untyped]) -> void
        def total: () -> { time: untyped, count: untyped, success: untyped, failed: untyped, skipped: untyped, error: untyped, suite_error: untyped }
      end
    end
  end
end
