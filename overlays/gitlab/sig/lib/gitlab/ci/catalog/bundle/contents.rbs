module Gitlab
  module Ci
    module Catalog
      module Bundle
        class Contents < ::Data
          def name: () -> untyped
          def version: () -> untyped
          def sha: () -> untyped
          def entry_path: () -> untyped
          def files: () -> untyped
          def self.new: (name: untyped, version: untyped, sha: untyped, entry_path: untyped, files: untyped) -> instance | (untyped name, untyped version, untyped sha, untyped entry_path, untyped files) -> instance
          def self.[]: (name: untyped, version: untyped, sha: untyped, entry_path: untyped, files: untyped) -> instance | (untyped name, untyped version, untyped sha, untyped entry_path, untyped files) -> instance
          def identity: () -> [untyped, untyped]
        end
      end
    end
  end
end
