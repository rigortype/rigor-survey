module Gitlab
  module VisibilityLevel
    def self.levels_for_user: (?untyped, ?include_private: untyped) -> ([0, 10, 20] | [10, 20, 0] | [10, 20] | [20])
    def self.string_values: () -> ["private", "internal", "public"]
    def self.options: () -> Hash[untyped, 0 | 10 | 20]
    def self.string_options: () -> Hash[String, 0 | 10 | 20]
    def self.allowed_for?: (untyped, untyped) -> (false | true)
    def self.allowed_level?: (untyped) -> (false | true)
    def self.non_restricted_level?: (untyped) -> (false | true)
    def self.valid_level?: (untyped) -> (false | true)
    def self.string_level: (untyped) -> ("internal" | "private" | "public" | nil)
    def visibility: () -> ("internal" | "private" | "public" | nil)
    def visibility_attribute_present?: (untyped) -> (false | true)
    def visibility_level_attributes: () -> [untyped, untyped, :visibility, "visibility"]
  end
end
