module ProjectsHelper
  def project_settings_tabs: () -> Array[{ name: "activities", action: :manage_project_activities, partial: "projects/settings/activities", label: :label_time_tracking } | { name: "boards", action: :manage_boards, partial: "projects/settings/boards", label: :label_board_plural } | { name: "categories", action: :manage_categories, partial: "projects/settings/issue_categories", label: :label_issue_category_plural } | { name: "info", action: :edit_project, partial: "projects/edit", label: :label_project } | { name: "issues", action: :edit_project, module: :issue_tracking, partial: "projects/settings/issues", label: :label_issue_tracking } | { name: "members", action: :manage_members, partial: "members/members", label: :label_member_plural, url: Hash[untyped, untyped] } | { name: "repositories", action: :manage_repository, partial: "projects/settings/repositories", label: :label_repository_plural } | { name: "versions", action: :manage_versions, partial: "projects/settings/versions", label: :label_version_plural, url: { tab: "versions", version_status: untyped, version_name: untyped } }]
  def render_project_action_links: () -> String
end
