module Observability
  class O11yToken
    def self.generate_tokens: (untyped) -> ({ accessJwt: untyped, refreshJwt: untyped } | { status: :provisioning } | {})
    def initialize: (untyped) -> void
    def generate_tokens: () -> ({ accessJwt: untyped, refreshJwt: untyped } | { status: :provisioning } | {})
    def http_client: () -> Observability::O11yToken::HttpClient
    class TokenResponse
      def self.from_json: (untyped) -> Observability::O11yToken::TokenResponse
      def initialize: (access_jwt: untyped, refresh_jwt: untyped) -> void
      def to_h: () -> { accessJwt: untyped, refreshJwt: untyped }
    end
  end
end
