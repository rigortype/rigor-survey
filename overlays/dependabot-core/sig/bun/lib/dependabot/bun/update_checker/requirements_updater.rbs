module Dependabot
  module Bun
    class UpdateChecker < ::Dependabot::UpdateCheckers::Base
      class RequirementsUpdater
        def initialize: (requirements: untyped, updated_source: untyped, update_strategy: untyped, latest_resolvable_version: untyped) -> void
        def updated_requirements: () -> (Array[Dependabot::DependencyRequirement | ::DependencyRequirement] | Array[Dependabot::DependencyRequirement])
        def requirements: () -> Array[Dependabot::DependencyRequirement]
        def latest_resolvable_version: () -> ::Bun::Version
      end
    end
  end
end
