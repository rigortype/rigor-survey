module Gitlab
  module GithubImport
    module Importer
      class CollaboratorsImporter
        def importer_class: () -> singleton(Gitlab::GithubImport::Importer::CollaboratorImporter)
        def representation_class: () -> singleton(Gitlab::GithubImport::Representation::Collaborator)
        def sidekiq_worker_class: () -> singleton(Gitlab::GithubImport::ImportCollaboratorWorker)
        def object_type: () -> :collaborator
        def collection_method: () -> :collaborators
      end
    end
  end
end
