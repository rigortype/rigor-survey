module Dependabot
  module Composer
    class FileFetcher < ::Dependabot::FileFetchers::Base
      class PathDependencyBuilder
        def initialize: (path: untyped, directory: untyped, lockfile: untyped) -> void
        def dependency_file: () -> (Dependabot::DependencyFile | nil)
      end
    end
  end
end
