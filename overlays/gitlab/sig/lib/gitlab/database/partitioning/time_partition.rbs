module Gitlab
  module Database
    module Partitioning
      class TimePartition
        def self.from_sql: (untyped, untyped, untyped) -> Gitlab::Database::Partitioning::TimePartition
        def self.from_export_definition: (untyped, untyped, untyped) -> Gitlab::Database::Partitioning::TimePartition
        def initialize: (untyped, untyped, untyped, partition_name: untyped) -> void
        def to_create_sql: () -> String
        def to_attach_sql: () -> String
        def to_detach_sql: (?concurrently: untyped) -> String
        def hash: () -> Integer
        def export_definition: () -> { partition_name: untyped, from: untyped, to: untyped }
        def from: () -> (Date | nil)
        def to: () -> (Date | nil)
      end
    end
  end
end
