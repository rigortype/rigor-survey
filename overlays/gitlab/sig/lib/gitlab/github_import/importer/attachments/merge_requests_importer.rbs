module Gitlab
  module GithubImport
    module Importer
      module Attachments
        class MergeRequestsImporter < ::Gitlab::GithubImport::Importer::Attachments::BaseImporter
          def sidekiq_worker_class: () -> singleton(Gitlab::GithubImport::Attachments::ImportMergeRequestWorker)
          def collection_method: () -> :merge_request_attachments
          def object_type: () -> :merge_request_attachment
        end
      end
    end
  end
end
