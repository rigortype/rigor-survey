module Dependabot
  module NpmAndYarn
    class UpdateChecker < ::Dependabot::UpdateCheckers::Base
      class ConflictingDependencyResolver
        def initialize: (dependency_files: untyped, credentials: untyped) -> void
        def conflicting_dependencies: (dependency: untyped, target_version: untyped, ?affected_versions: untyped) -> Array[Dependabot::UpdateCheckers::Conflict]
      end
    end
  end
end
