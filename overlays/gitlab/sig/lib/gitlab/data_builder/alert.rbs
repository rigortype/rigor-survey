module Gitlab
  module DataBuilder
    module Alert
      def build: (untyped) -> { object_kind: "alert", object_attributes: { title: untyped, url: untyped, severity: untyped, events: untyped, status: untyped, started_at: untyped } }
      def hook_attrs: (untyped) -> { title: untyped, url: untyped, severity: untyped, events: untyped, status: untyped, started_at: untyped }
    end
  end
end
