module Gitlab
  module Database
    module Capture
      class Task
        def initialize: (database_name: untyped) -> void
        def call: () -> Array[singleton(Gitlab::AppJsonLogger)]
        def chunk_max_statements: () -> 10000
        def client_identifier: () -> String
        def queue: () -> Thread::SizedQueue[untyped]
      end
    end
  end
end
