module Dependabot
  module Hex
    class UpdateChecker < ::Dependabot::UpdateCheckers::Base
      def latest_version: () -> (Dependabot::Version | Gem::Version | String | nil)
      def latest_resolvable_version: () -> (Dependabot::Version | Gem::Version | String | nil)
      def latest_resolvable_version_with_no_unlock: () -> (Dependabot::Version | String | nil)
      def updated_requirements: () -> Array[Dependabot::DependencyRequirement]
    end
  end
end
