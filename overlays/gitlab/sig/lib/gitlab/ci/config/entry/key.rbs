module Gitlab
  module Ci
    class Config
      module Entry
        class Key < ::Gitlab::Config::Entry::Simplifiable
          def self.default: () -> "default"
          class SimpleKey < ::Gitlab::Config::Entry::Node
            def self.default: () -> "default"
          end
          class UnknownStrategy < ::Gitlab::Config::Entry::Node
            def errors: () -> [String]
          end
        end
      end
    end
  end
end
