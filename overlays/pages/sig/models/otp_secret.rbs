class OtpSecret
  def initialize: (untyped) -> void
  def generate_recovery_codes: () -> [String, String, String, String, String, String, String, String, String, String]
  def regenerate_recovery_codes!: () -> Array[String]
  def validate_otp!: (untyped) -> (false | true)
  class InvalidUserError < ::StandardError
  end
end
