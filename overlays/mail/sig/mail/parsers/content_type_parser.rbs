module Mail
  module Parsers
    module ContentTypeParser
      def self.parse: (untyped) -> Mail::Parsers::ContentTypeParser::ContentTypeStruct
      class ContentTypeStruct < ::Struct[untyped]
        def main_type: () -> untyped
        def sub_type: () -> untyped
        def parameters: () -> untyped
        def error: () -> untyped
        def main_type=: (untyped) -> untyped
        def sub_type=: (untyped) -> untyped
        def parameters=: (untyped) -> untyped
        def error=: (untyped) -> untyped
        def self.new: (?main_type: untyped, ?sub_type: untyped, ?parameters: untyped, ?error: untyped) -> instance | (?untyped main_type, ?untyped sub_type, ?untyped parameters, ?untyped error) -> instance
        def self.[]: (?main_type: untyped, ?sub_type: untyped, ?parameters: untyped, ?error: untyped) -> instance | (?untyped main_type, ?untyped sub_type, ?untyped parameters, ?untyped error) -> instance
      end
    end
  end
end
