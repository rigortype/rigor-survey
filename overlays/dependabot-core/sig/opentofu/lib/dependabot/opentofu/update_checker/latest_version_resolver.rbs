module Dependabot
  module Opentofu
    class UpdateChecker < ::Dependabot::UpdateCheckers::Base
      class LatestVersionResolver
        def initialize: (dependency: untyped, credentials: untyped, cooldown_options: untyped, git_commit_checker: untyped) -> void
        def latest_version_tag: () -> (Dependabot::GitTagDetails | nil)
        def check_if_version_in_cooldown_period?: (untyped) -> (false | true)
        def release_date_to_seconds: (untyped) -> (0 | Integer)
        def package_details_fetcher: () -> (::Package::PackageDetailsFetcher | nil)
      end
    end
  end
end
