module Gitlab
  module GithubImport
    module Attachments
      class ImportReleaseWorker
        def representation_class: () -> singleton(Gitlab::GithubImport::Representation::NoteText)
        def importer_class: () -> singleton(Gitlab::GithubImport::Importer::NoteAttachmentsImporter)
        def object_type: () -> :release_attachment
        def increment_object_counter?: (untyped) -> false
      end
    end
  end
end
