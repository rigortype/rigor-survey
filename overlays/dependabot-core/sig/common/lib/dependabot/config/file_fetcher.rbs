module Dependabot
  module Config
    class FileFetcher < ::Dependabot::FileFetchers::Base
      def self.required_files_in?: (untyped) -> (false | true)
      def self.required_files_message: () -> String
      def config_file: () -> (Dependabot::DependencyFile | nil)
      def fetch_files: () -> Array[untyped]
    end
  end
end
