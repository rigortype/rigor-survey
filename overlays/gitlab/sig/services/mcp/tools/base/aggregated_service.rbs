module Mcp
  module Tools
    module Base
      class AggregatedService < ::Mcp::Tools::Base::BaseService
        def self.tool_name: () -> bot
        def initialize: (tools: untyped, ?version: untyped) -> void
        class ToolNotConfiguredError < ::StandardError
          def initialize: (untyped) -> void
        end
      end
    end
  end
end
