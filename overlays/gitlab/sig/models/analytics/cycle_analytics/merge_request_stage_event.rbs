module Analytics
  module CycleAnalytics
    class MergeRequestStageEvent < ::ApplicationRecord
      def self.project_column: () -> :target_project_id
      def self.issuable_id_column: () -> :merge_request_id
      def self.issuable_model: () -> singleton(MergeRequest)
      def self.assignees_model: () -> singleton(MergeRequestAssignee)
    end
  end
end
