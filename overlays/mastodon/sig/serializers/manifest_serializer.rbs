class ManifestSerializer < ::ActiveModel::Serializer[untyped]
  def id: () -> "/home"
  def theme_color: () -> "#191b22"
  def background_color: () -> "#191b22"
  def display: () -> "standalone"
  def start_url: () -> "/"
  def scope: () -> "/"
  def share_target: () -> { url_template: "share?title={title}&text={text}&url={url}", action: "share", method: "GET", enctype: "application/x-www-form-urlencoded", params: { title: "title", text: "text", url: "url" } }
  def shortcuts: () -> [{ name: "Compose new post", url: "/publish" }, { name: "Notifications", url: "/notifications" }, { name: "Explore", url: "/explore" }]
  def prefer_related_applications: () -> true
  def related_applications: () -> [{ platform: "play", url: "https://play.google.com/store/apps/details?id=org.joinmastodon.android", id: "org.joinmastodon.android" }, { platform: "itunes", url: "https://apps.apple.com/us/app/mastodon-for-iphone/id1571998974", id: "id1571998974" }, { platform: "f-droid", url: "https://f-droid.org/en/packages/org.joinmastodon.android/", id: "org.joinmastodon.android" }]
end
