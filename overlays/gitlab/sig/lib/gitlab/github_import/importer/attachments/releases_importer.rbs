module Gitlab
  module GithubImport
    module Importer
      module Attachments
        class ReleasesImporter < ::Gitlab::GithubImport::Importer::Attachments::BaseImporter
          def sidekiq_worker_class: () -> singleton(Gitlab::GithubImport::Attachments::ImportReleaseWorker)
          def collection_method: () -> :release_attachments
          def object_type: () -> :release_attachment
        end
      end
    end
  end
end
