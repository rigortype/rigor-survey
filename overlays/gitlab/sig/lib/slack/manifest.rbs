module Slack
  module Manifest
    def self.share_url: (?duo_enabled: untyped, ?mcp_enabled: untyped) -> String
    def self.to_json: (?duo_enabled: untyped, ?mcp_enabled: untyped) -> String
    def self.to_h: (?duo_enabled: untyped, ?mcp_enabled: untyped) -> { display_information: { name: String, description: untyped, background_color: "#171321", long_description: String }, features: Hash[untyped, untyped] | { app_home: { home_tab_enabled: true, messages_tab_enabled: untyped, messages_tab_read_only_enabled: false | true }, bot_user: { display_name: "GitLab", always_online: true }, slash_commands: [{ command: "/gitlab", url: String, description: untyped, usage_hint: untyped, should_escape: false }] }, oauth_config: { redirect_urls: [untyped], scopes: Hash[untyped, untyped] | { bot: untyped } }, settings: Hash[untyped, untyped] | { event_subscriptions: { request_url: String, bot_events: Array[untyped] | ["app_home_opened", "app_mention"] | ["app_home_opened"] }, interactivity: { is_enabled: true, request_url: String, message_menu_options_url: String }, org_deploy_enabled: false, socket_mode_enabled: false, token_rotation_enabled: false } }
    def self.display_information: () -> { name: String, description: untyped, background_color: "#171321", long_description: String }
    def self.features: (agent_app: untyped) -> (Hash[untyped, untyped] | { app_home: { home_tab_enabled: true, messages_tab_enabled: untyped, messages_tab_read_only_enabled: false | true }, bot_user: { display_name: "GitLab", always_online: true }, slash_commands: [{ command: "/gitlab", url: String, description: untyped, usage_hint: untyped, should_escape: false }] })
    def self.app_home: (agent_app: untyped) -> { home_tab_enabled: true, messages_tab_enabled: untyped, messages_tab_read_only_enabled: false | true }
    def self.oauth_config: (duo_enabled: untyped, mcp_enabled: untyped) -> { redirect_urls: [untyped], scopes: Hash[untyped, untyped] | { bot: untyped } }
    def self.settings: (duo_enabled: untyped, agent_app: untyped, mcp_enabled: untyped) -> (Hash[untyped, untyped] | { event_subscriptions: { request_url: String, bot_events: Array[untyped] | ["app_home_opened", "app_mention"] | ["app_home_opened"] }, interactivity: { is_enabled: true, request_url: String, message_menu_options_url: String }, org_deploy_enabled: false, socket_mode_enabled: false, token_rotation_enabled: false })
    def self.api_v4: (untyped) -> String
  end
end
