module Projects
  module CustomBranchRule
    def initialize: (untyped) -> void
    def name: () -> bot
    def matching_branches_count: () -> bot
    def default_branch?: () -> false
    def protected?: () -> false
    def branch_protection: () -> nil
    def group: () -> nil
    def squash_option: () -> nil
    def created_at: () -> nil
    def updated_at: () -> nil
  end
end
