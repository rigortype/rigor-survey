module Gitlab
  module GithubImport
    module Importer
      class PullRequestImporter
        def initialize: (untyped, untyped, untyped) -> void
        def import_attributes: () -> { iid: untyped, title: untyped, description: untyped, source_project_id: untyped, target_project_id: untyped, source_branch: untyped, target_branch: untyped, state_id: untyped, milestone_id: untyped, author_id: untyped, created_at: untyped, updated_at: untyped, imported_from: untyped }
        def set_merge_request_assignees: (untyped) -> ([untyped] | nil)
        def user_finder: () -> Gitlab::GithubImport::UserFinder
        def milestone_finder: () -> Gitlab::GithubImport::MilestoneFinder
        def issuable_finder: () -> Gitlab::GithubImport::IssuableFinder
      end
    end
  end
end
