module Dependabot
  module Elm
    class UpdateChecker < ::Dependabot::UpdateCheckers::Base
      class RequirementsUpdater
        def initialize: (requirements: untyped, latest_resolvable_version: untyped) -> void
        def updated_requirements: () -> (Array[Dependabot::DependencyRequirement] | Array[::DependencyRequirement])
        def requirements: () -> Array[Dependabot::DependencyRequirement]
        def latest_resolvable_version: () -> (Dependabot::Version | nil)
      end
    end
  end
end
