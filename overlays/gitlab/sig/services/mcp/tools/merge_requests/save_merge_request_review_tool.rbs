module Mcp
  module Tools
    module MergeRequests
      class SaveMergeRequestReviewTool < ::Mcp::Tools::Base::GraphqlTool
        def graphql_operation: () -> String
        def operation_name: () -> ("createDiffNote" | "createNote" | "discussionToggleResolve")
        def build_variables: () -> ({ input: Hash[untyped, untyped] } | { input: { id: untyped, resolve: untyped } } | { input: { noteableId: untyped, body: untyped, discussionId: untyped } } | { input: { noteableId: untyped, body: untyped, position: Hash[untyped, untyped] } })
      end
    end
  end
end
