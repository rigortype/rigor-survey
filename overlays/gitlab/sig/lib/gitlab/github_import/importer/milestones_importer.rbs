module Gitlab
  module GithubImport
    module Importer
      class MilestonesImporter
        def build_milestones: () -> [Array[untyped], Array[untyped]]
        def build_attributes: (untyped) -> { iid: untyped, title: untyped, description: untyped, project_id: untyped, state: :active | :closed, due_date: untyped, created_at: untyped, updated_at: untyped }
        def state_for: (untyped) -> (:active | :closed)
        def object_type: () -> :milestone
      end
    end
  end
end
