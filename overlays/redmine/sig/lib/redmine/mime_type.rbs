module Redmine
  module MimeType
    def self.by_type: (untyped) -> Array["application/javascript" | "application/pdf" | "image/avif" | "image/bmp" | "image/gif" | "image/jpeg" | "image/png" | "image/tiff" | "image/webp" | "text/css" | "text/csv" | "text/html" | "text/jsp" | "text/plain" | "text/x-c" | "text/x-csh" | "text/x-csharp" | "text/x-html-template" | "text/x-java" | "text/x-perl" | "text/x-php" | "text/x-po" | "text/x-python" | "text/x-ruby" | "text/x-sh" | "text/x-textile" | "text/xml" | "text/yaml" | "video/mp4" | "video/webm"]
    def self.friendly_name_for: (untyped) -> ("Microsoft Excel Workbook (+macro)" | "Microsoft Excel Workbook Template (+macro)" | "Microsoft Excel Workbook Template" | "Microsoft Excel Workbook" | "Microsoft PowerPoint Presentation (+macro)" | "Microsoft PowerPoint Presentation Template (+macro)" | "Microsoft PowerPoint Presentation Template" | "Microsoft PowerPoint Presentation" | "Microsoft PowerPoint Slide Show (+macro)" | "Microsoft PowerPoint Slide Show" | "Microsoft Word Document (+macro)" | "Microsoft Word Document Template (+macro)" | "Microsoft Word Document Template" | "Microsoft Word Document" | "OpenDocument Graphics Template" | "OpenDocument Graphics" | "OpenDocument Presentation Template" | "OpenDocument Presentation" | "OpenDocument Spreadsheet Template" | "OpenDocument Spreadsheet" | "OpenDocument Text Template" | "OpenDocument Text" | nil)
