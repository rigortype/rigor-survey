module Concurrent
  class ReentrantReadWriteLock < ::Concurrent::Synchronization::Object
    def acquire_read_lock: () -> (nil | true)
    def try_read_lock: () -> (false | true)
    def release_read_lock: () -> true
    def acquire_write_lock: () -> (nil | true)
    def try_write_lock: () -> (false | true)
    def release_write_lock: () -> true
  end
end
