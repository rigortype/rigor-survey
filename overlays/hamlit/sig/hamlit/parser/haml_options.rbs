module Hamlit
  class HamlOptions
    def self.wrap: (untyped) -> Hamlit::HamlOptions
    def initialize: (?untyped) -> void
    def xhtml?: () -> (false | true)
    def html?: () -> (false | true)
    def html4?: () -> (false | true)
    def html5?: () -> (false | true)
    def encoding=: (untyped) -> ("UTF-8" | nil)
  end
end
