module Dependabot
  module Conda
    class UpdateChecker < ::Dependabot::UpdateCheckers::Base
      class RequirementsUpdater
        def initialize: (requirements: untyped, update_strategy: untyped, latest_resolvable_version: untyped) -> void
        def updated_requirements: () -> Array[Dependabot::DependencyRequirement]
        def requirements: () -> Array[Dependabot::DependencyRequirement]
        def latest_resolvable_version: () -> (Dependabot::Conda::Version | nil)
      end
    end
  end
end
