module Types
  module Namespaces
    module LinkPaths
      def self.type_mappings: () -> Hash[singleton(Group) | singleton(::Namespaces::ProjectNamespace) | singleton(::Namespaces::UserNamespace), singleton(Types::Namespaces::LinkPaths::GroupNamespaceLinksType) | singleton(Types::Namespaces::LinkPaths::ProjectNamespaceLinksType) | singleton(Types::Namespaces::LinkPaths::UserNamespaceLinksType)]
      def self.resolve_type: (untyped, untyped) -> (singleton(Types::Namespaces::LinkPaths::GroupNamespaceLinksType) | singleton(Types::Namespaces::LinkPaths::ProjectNamespaceLinksType) | singleton(Types::Namespaces::LinkPaths::UserNamespaceLinksType))
      class UrlHelpers
        def initialize: (untyped) -> void
        def feed_url_options: (untyped, untyped) -> { format: untyped, feed_token: untyped }
      end
    end
  end
end
