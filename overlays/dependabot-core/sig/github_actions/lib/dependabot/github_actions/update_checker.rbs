module Dependabot
  module GithubActions
    class UpdateChecker < ::Dependabot::UpdateCheckers::Base
      def latest_version: () -> (Gem::Version | String | nil)
      def latest_resolvable_version: () -> (Gem::Version | String | nil)
      def lowest_resolvable_security_fix_version: () -> (Dependabot::Version | nil)
      def lowest_security_fix_version: () -> (Dependabot::Version | nil)
    end
  end
end
