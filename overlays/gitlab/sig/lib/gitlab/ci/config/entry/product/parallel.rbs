module Gitlab
  module Ci
    class Config
      module Entry
        module Product
          class Parallel < ::Gitlab::Config::Entry::Simplifiable
            class ParallelBuilds < ::Gitlab::Config::Entry::Node
              def value: () -> { number: untyped }
            end
            class UnknownStrategy < ::Gitlab::Config::Entry::Node
              def errors: () -> [String]
            end
          end
        end
      end
    end
  end
end
