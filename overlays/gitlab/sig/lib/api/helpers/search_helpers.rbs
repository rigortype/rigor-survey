module API
  module Helpers
    module SearchHelpers
      def self.global_search_scopes: () -> ["projects", "groups", "issues", "work_items", "merge_requests", "milestones", "snippet_titles", "users"]
      def self.group_search_scopes: () -> ["projects", "groups", "issues", "work_items", "merge_requests", "milestones", "users"]
      def self.project_search_scopes: () -> ["issues", "work_items", "merge_requests", "milestones", "notes", "wiki_blobs", "commits", "blobs", "users"]
      def self.search_states: () -> ["all", "opened", "closed", "merged"]
      def self.work_item_type_filter_desc: () -> String
      def self.search_param_keys: () -> [:scope, :search, :state, :confidential, :search_type, :include_archived, :page, :per_page, :order_by, :sort, :type]
      def self.search_negated_param_keys: () -> []
      def self.gitlab_search_mcp_params: () -> [:scope, :search, :state, :confidential, :search_type, :include_archived, :page, :per_page, :order_by, :sort, :type, :id]
    end
  end
end
