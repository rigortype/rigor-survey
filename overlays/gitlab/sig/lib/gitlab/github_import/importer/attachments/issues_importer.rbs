module Gitlab
  module GithubImport
    module Importer
      module Attachments
        class IssuesImporter < ::Gitlab::GithubImport::Importer::Attachments::BaseImporter
          def sidekiq_worker_class: () -> singleton(Gitlab::GithubImport::Attachments::ImportIssueWorker)
          def collection_method: () -> :issue_attachments
          def object_type: () -> :issue_attachment
        end
      end
    end
  end
end
