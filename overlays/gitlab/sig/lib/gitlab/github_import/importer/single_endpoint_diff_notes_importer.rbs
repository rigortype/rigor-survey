module Gitlab
  module GithubImport
    module Importer
      class SingleEndpointDiffNotesImporter
        def importer_class: () -> singleton(Gitlab::GithubImport::Importer::DiffNoteImporter)
        def representation_class: () -> singleton(Gitlab::GithubImport::Representation::DiffNote)
        def sidekiq_worker_class: () -> singleton(Gitlab::GithubImport::ImportDiffNoteWorker)
        def object_type: () -> :diff_note
        def collection_method: () -> :pull_request_comments
      end
    end
  end
end
