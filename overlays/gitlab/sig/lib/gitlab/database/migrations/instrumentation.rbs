module Gitlab
  module Database
    module Migrations
      class Instrumentation
        def initialize: (result_dir: untyped, ?observer_classes: [singleton(Gitlab::Database::Migrations::Observers::MigrationObserver)]) -> void
        def observe: (version: untyped, name: untyped, connection: untyped, ?meta: untyped) ?{ (*untyped) -> untyped } -> Gitlab::Database::Migrations::Observation
        def observe_no_batches_processed: () -> top
        def observer_classes: () -> [singleton(Gitlab::Database::Migrations::Observers::MigrationObserver)]
      end
    end
  end
end
