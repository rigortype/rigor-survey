module Sidebars
  module YourWork
    module Menus
      class IssuesMenu < ::Sidebars::Menu
        def sprite_icon: () -> "work-items"
        def render?: () -> (false | true)
        def active_routes: () -> { path: ["dashboard#issues", "dashboard#work_items"] }
        def has_pill?: () -> true
        def pill_count_field: () -> "assigned_issues"
      end
    end
  end
end
