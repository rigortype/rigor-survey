module Dependabot
  module Sbt
    class FileFetcher < ::Dependabot::FileFetchers::Base
      def self.required_files_message: () -> "Repo must contain a build.sbt file."
      def fetch_files: () -> Array[untyped]
      def ecosystem_versions: () -> (nil | { package_managers: Hash[String, String] })
    end
  end
end
